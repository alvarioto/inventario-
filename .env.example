# Configuración pública de la app web Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL pública del backend Express que guarda la clave de DeepSeek.
# En local puede quedarse vacío; en Firebase Hosting será, por ejemplo,
# https://api.tudominio.es
VITE_API_BASE_URL=

# Endpoint serverless que consulta el Price Guide real de hobbyDB.
# La cookie/sesión de hobbyDB se guarda únicamente como secreto del backend
# (HOBBYDB_COOKIE) y nunca se expone en variables VITE_* ni en el navegador.
VITE_HOBBYDB_VALUE_URL=

# true permite probar la interfaz con datos locales sin Firebase.
VITE_DEMO_MODE=false
