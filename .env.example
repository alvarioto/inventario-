# Configuración pública de la app web Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic: por defecto usa Gemini 3.5 Flash-Lite (nivel gratuito, multimodal).
VITE_AI_MODEL=gemini-3.5-flash-lite

# App Check: Key ID público de reCAPTCHA Enterprise.
# Firebase AI Logic lo requiere para una app web publicada.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Solo para desarrollar en localhost. NO activar en producción.
VITE_APPCHECK_DEBUG=false

# true permite probar la interfaz con datos locales sin Firebase.
VITE_DEMO_MODE=false
