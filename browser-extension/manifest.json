{
  "manifest_version": 3,
  "name": "FrikiVault · ActionFigure411",
  "version": "1.0.0",
  "description": "Permite a FrikiVault consultar ActionFigure411 usando tu navegador real.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.actionfigure411.com/*",
    "https://frikivault-alvarioto-2026.web.app/*",
    "https://frikivault-alvarioto-2026.firebaseapp.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://frikivault-alvarioto-2026.web.app/*",
        "https://frikivault-alvarioto-2026.firebaseapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-frikivault.js"],
      "run_at": "document_start"
    }
  ]
}
