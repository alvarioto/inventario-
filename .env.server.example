# Copia a .env.server. NUNCA uses el prefijo VITE_ para secretos.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Opcional: mejora la cobertura de búsqueda. eBay se consulta por páginas públicas;
# no se necesita cuenta, Client ID ni Client Secret de eBay.
BRAVE_SEARCH_API_KEY=
# Opcional: API oficial PriceCharting (suscripción con acceso API, token de 40 caracteres).
PRICECHARTING_API_TOKEN=
HOST=127.0.0.1
PORT=4173
# Para publicar el servidor con HTTPS y restringirlo a tu cuenta:
FIREBASE_PROJECT_ID=
OWNER_UID=
APP_ORIGIN=
